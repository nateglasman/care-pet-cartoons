# --- On Replit you normally need NONE of these. ---
# Enable "AI Integrations" in the Replit workspace and Replit injects
# AI_INTEGRATIONS_ANTHROPIC_API_KEY / _BASE_URL (and the OpenAI / Gemini
# equivalents) into the environment. The app picks those up automatically.

# --- Run anywhere else (laptop, GitHub Codespace, etc.) with your own keys ---
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

# Which image model draws the cartoon: "openai" (default) or "gemini"
# CARTOON_PROVIDER=openai
# CARTOON_MODEL=gpt-image-1.5        # needs transparent-background support; or e.g. gemini-2.5-flash-image for gemini
# BREED_MODEL=claude-opus-5-5
# CARTOON_STYLE=friendly flat-color cartoon with bold outlines, like a modern animated series

# Run the whole pipeline with no API calls (placeholder breed + posterized photo)
# MOCK_AI=1

# Shelterluv shelter id (3204 = C.A.R.E. North Shore, from carenorthshore.org embed)
# SHELTERLUV_SHELTER_ID=3204
